    {
      "parameters": {
        "jsCode": "// On récupère tous les items entrants\nconst items = $input.all();\n\n// On prépare un tableau pour stocker tous les noms trouvés\nlet tousLesMotifs = [];\n\nfor (const item of items) {\n  // On vérifie si le champ existe et est bien une liste\n  const options = item.json.custom_field_options;\n  \n  if (Array.isArray(options)) {\n    // On extrait les 'name' et on les ajoute à notre tableau global\n    const noms = options.map(option => option.value);\n    tousLesMotifs = tousLesMotifs.concat(noms);\n  }\n}\n\n// On retourne un seul item avec le champ \"Motifs\"\nreturn {\n  Motifs: tousLesMotifs\n};"
      },
