    {
      "parameters": {
        "jsCode": "function parseMarkdown(text) {\n  if (!text) return '';\n  let html = text.toString();\n\n  // 1. Nettoyage préliminaire\n  html = html.replace(/\\\\n/g, '\\n');\n  html = html.replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\n  // 2. GESTION DES TITRES\n  html = html.replace(/^(\\#{2,6})\\s+(.*)$/gm, (match, hashes, content) => {\n      const level = hashes.length;\n      if (level === 4) return `<h6 style=\"margin: 10px 0 2px 0; font-size: 12px; font-weight: bold; color: #000;\">${content}</h6>`;\n      if (level === 3) return `<h5 style=\"margin: 12px 0 5px 0; font-size: 12px; color: #777; text-transform: uppercase; letter-spacing: 0.5px;\">${content}</h5>`;\n      if (level === 2) return `<h4 style=\"margin: 18px 0 8px 0; font-size: 15px; color: #2c3e50; border-bottom: 1px solid #ddd; padding-bottom: 4px;\">${content}</h4>`;\n      return `<strong>${content}</strong><br>`;\n  });\n\n  // 3. TRAITEMENT DES LISTES\n  html = html.replace(/^\\s*[\\-\\*]\\s+(.*)$/gm, '<li style=\"margin-left: 20px;\">$1</li>');\n  html = html.replace(/((<li.*>.*<\\/li>\\n*)+)/g, '<ul style=\"margin-bottom: 10px;\">$1</ul>');\n\n  // 4. FORMATAGE TEXTE\n  html = html.replace(/\\*\\*(.*?)\\*\\*/g, '<strong>$1</strong>');\n  html = html.replace(/\\*([^\\*]+)\\*/g, '<em>$1</em>');\n\n  // 5. FINITIONS\n  html = html.replace(/\\n/g, '<br>');\n  html = html.replace(/<\\/ul><br>/g, '</ul>');\n  html = html.replace(/<\\/h[456]><br>/g, (match) => match.replace('<br>', ''));\n\n  return html;\n}\n\n// Adaptation pour ton nœud n8n (Input unique : reponse)\nreturn $input.all().map(item => {\n  const rawText = item.json.output.reponse || '';\n  item.json.html_note = parseMarkdown(rawText);\n  return item;\n});"
      },
